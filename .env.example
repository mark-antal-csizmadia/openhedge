# Copy to .env and fill in secrets. docker compose reads OPENROUTER_API_KEY from .env.

# Required for market sync and /v1/search.
OPENROUTER_API_KEY=

# Optional. Local Qdrant in docker compose has no API key.
# QDRANT_API_KEY=

# Optional overrides (defaults shown). docker compose sets its own Qdrant URL and bind addresses.
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=markets
# QDRANT_POINT_ID_NAMESPACE=https://openhedge.app/markets
# QDRANT_TIMEOUT=30
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENROUTER_EMBEDDING_DIM=768
# OPENROUTER_HTTP_REFERER=https://openhedge.app
# OPENROUTER_APP_TITLE=openhedge
# API_HOST=127.0.0.1
# API_PORT=8000
# MCP_HOST=127.0.0.1
# MCP_PORT=8001
# OPENHEDGE_API_URL=http://127.0.0.1:8000
# SYNC_INTERVAL_SECONDS=3600
# BATCH_SIZE=64
