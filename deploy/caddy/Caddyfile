{
	auto_https off
}

:{$PORT:8080} {
	# Railway healthcheck. Do not proxy this to MCP or Caddy deploys wait on MCP.
	handle /health {
		header Content-Type application/json
		respond `{"status":"ok"}` 200
	}

	# UPSTREAM_URL is host:port (no http://). Quotes stop Caddy {http.*} placeholders
	# from swallowing a scheme and dialing :8001 on this container.
	handle {
		reverse_proxy "{$UPSTREAM_URL}" {
			flush_interval -1
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}
}
